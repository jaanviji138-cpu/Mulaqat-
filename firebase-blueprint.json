{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and economic data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "country": { "type": "string" },
        "level": { "type": "integer" },
        "experience": { "type": "integer" },
        "coins": { "type": "integer" },
        "diamonds": { "type": "integer" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "visitorsCount": { "type": "integer" },
        "isVIP": { "type": "boolean" },
        "agencyId": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "coins", "diamonds", "level"]
    },
    "Room": {
      "title": "Room",
      "description": "Voice chat room data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "hostId": { "type": "string" },
        "coHostIds": { "type": "array", "items": { "type": "string" } },
        "memberCount": { "type": "integer" },
        "category": { "type": "string" },
        "backgroundTheme": { "type": "string" },
        "isLive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "hostId"]
    },
    "RoomMember": {
      "title": "Room Member",
      "description": "Member state within a room",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["host", "co-host", "audience"] },
        "isMuted": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["text", "gift", "system"] },
        "read": { "type": "boolean" },
        "readAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "timestamp"]
    },
    "Gift": {
      "title": "Gift",
      "description": "Virtual gift metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "coinCost": { "type": "integer" },
        "diamondValue": { "type": "integer" },
        "animationUrl": { "type": "string" },
        "iconUrl": { "type": "string" }
      },
      "required": ["id", "name", "coinCost"]
    },
    "Agency": {
      "title": "Agency",
      "description": "User agency data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "memberCount": { "type": "integer" },
        "totalEarnings": { "type": "integer" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "Follow": {
      "title": "Follow",
      "description": "User follow relationship",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "targetId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "targetId", "timestamp"]
    },
    "Visitor": {
      "title": "Visitor",
      "description": "User profile visitor log record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "visitedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "visitedAt"]
    },
    "SystemBan": {
      "title": "System Ban",
      "description": "System-wide ban/restriction records for User IDs or Device IDs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["id_ban", "device_ban", "id_restriction"] },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "restrictionType": { "type": "string", "enum": ["ban", "mute", "chat_ban"] },
        "restrictedUntil": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "bannedBy": { "type": "string" }
      },
      "required": ["id", "type", "targetId", "createdAt"]
    },
    "Recording": {
      "title": "Recording",
      "description": "Vocal recording with audio base64 data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "audioData": { "type": "string" },
        "timestamp": { "type": "string" },
        "scriptText": { "type": "string" },
        "duration": { "type": "integer" }
      },
      "required": ["userId", "title", "audioData"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Real-time activity feed event log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["room_started", "room_joined", "gift_sent", "new_follower"] },
        "userUid": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": {
          "type": "object",
          "properties": {
            "roomId": { "type": "string" },
            "roomTitle": { "type": "string" },
            "giftName": { "type": "string" },
            "giftIcon": { "type": "string" },
            "targetUid": { "type": "string" },
            "targetName": { "type": "string" }
          }
        }
      },
      "required": ["id", "type", "userUid", "userName", "timestamp"]
    },
    "HostApplication": {
      "title": "HostApplication",
      "description": "Host onboarding application submitted by creators",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "realName": { "type": "string" },
        "age": { "type": "integer" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "ratePerMinute": { "type": "integer" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "realName", "age", "status", "createdAt"]
    },
    "VideoCall": {
      "title": "VideoCall",
      "description": "1-on-1 video call session, ringing state synchronization, and WebRTC signaling",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerPhoto": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverPhoto": { "type": "string" },
        "status": { "type": "string", "enum": ["ringing", "connected", "declined", "ended", "missed"] },
        "signalingState": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "connectedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "endReason": { "type": "string" },
        "ratePerMinute": { "type": "integer" }
      },
      "required": ["id", "callerId", "receiverId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/video_calls/{callId}": { "schema": "VideoCall", "description": "1-on-1 video call sessions, ringing status synchronization, and WebRTC signaling data" },
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/users/{userId}/visitors/{visitorId}": { "schema": "Visitor", "description": "Profile visitors log" },
    "/rooms/{roomId}": { "schema": "Room", "description": "Voice rooms" },
    "/rooms/{roomId}/members/{memberId}": { "schema": "RoomMember", "description": "Members in a room" },
    "/rooms/{roomId}/supporters/{userId}": { "schema": "object", "description": "Gift supporters tracking" },
    "/rooms/{roomId}/hand_raises/{userId}": { "schema": "object", "description": "Hand raise requests to speak" },
    "/rooms/{roomId}/streams/{speakerId}": { "schema": "object", "description": "Audio streams for active speakers" },
    "/rooms/{roomId}/streams/{speakerId}/subscribers/{subscriberId}": { "schema": "object", "description": "RTC signaling subscriber records" },
    "/rooms/{roomId}/messages/{messageId}": { "schema": "Message", "description": "Room messages" },
    "/rooms/{roomId}/comments/{commentId}": { "schema": "object", "description": "Room comments" },
    "/rooms/{roomId}/reactions/{reactionId}": { "schema": "object", "description": "Room floating emoji reactions" },
    "/rooms/{roomId}/adminLogs/{logId}": { "schema": "object", "description": "Room administration action logs" },
    "/gifts/{giftId}": { "schema": "Gift", "description": "Gift definitions" },
    "/agencies/{agencyId}": { "schema": "Agency", "description": "Agencies" },
    "/private_chats/{chatId}/messages/{messageId}": { "schema": "Message", "description": "Private messages" },
    "/follows/{followId}": { "schema": "Follow", "description": "User follow relationships" },
    "/gift_logs/{logId}": { "schema": "object", "description": "Gift transactions" },
    "/posts/{postId}": { "schema": "object", "description": "Moments posts" },
    "/posts/{postId}/comments/{commentId}": { "schema": "object", "description": "Comments on posts" },
    "/stories/{storyId}": { "schema": "object", "description": "Moments status/stories" },
    "/recordings/{recordingId}": { "schema": "Recording", "description": "Saved vocal recordings" },
    "/room_events/{eventId}": { "schema": "object", "description": "Events scheduled in voice rooms" },
    "/notifications/{notificationId}": { "schema": "object", "description": "User alert notifications" },
    "/store_logs/{logId}": { "schema": "object", "description": "App store purchases" },
    "/referrals/{referralId}": { "schema": "object", "description": "Referrals tracking" },
    "/live_moments/{momentId}": { "schema": "object", "description": "Community Live Moments feed with pinning and comments" },
    "/support_chats/{userId}/messages/{messageId}": { "schema": "Message", "description": "Support chat messages" },
    "/system_bans/{banId}": { "schema": "SystemBan", "description": "System-wide bans and temporary restrictions" },
    "/activities/{activityId}": { "schema": "Activity", "description": "Real-time activity logs" },
    "/host_applications/{appId}": { "schema": "HostApplication", "description": "Host applications submitted by creators" }
  }
}
